# Application
NODE_ENV=development
PORT=3000

# OpenAI (for LangChain)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (alternative for LangChain)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bmad_forms
# Or MongoDB
# MONGODB_URI=mongodb://localhost:27017/bmad_forms

# Redis (caching)
REDIS_URL=redis://localhost:6379

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# CORS
CORS_ORIGIN=http://localhost:4200

# LangChain Settings
LANGCHAIN_MODEL=gpt-4
LANGCHAIN_TEMPERATURE=0.3
LANGCHAIN_MAX_TOKENS=2000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
