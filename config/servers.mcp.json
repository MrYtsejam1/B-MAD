{
  "servers": [
    {
      "id": "invoice",
      "name": "Invoice/Bill Refund",
      "description": "Submit expense invoices and bill refunds for reimbursement",
      "mode": "mock",
      "baseUrl": "https://api.company.com/invoices",
      "mockBaseUrl": "/mock/invoices",
      "auth": {
        "type": "none"
      },
      "operations": [
        {
          "id": "submit",
          "method": "POST",
          "path": "/submit",
          "inputSchema": "invoice-submit.request.json",
          "outputSchema": "invoice-submit.response.json",
          "description": "Submit a new invoice for approval"
        },
        {
          "id": "status",
          "method": "GET",
          "path": "/status/:id",
          "outputSchema": "invoice-status.response.json",
          "description": "Get invoice status"
        }
      ],
      "workflow": {
        "steps": ["DRAFT", "SUBMITTED", "MANAGER_APPROVED", "FINANCE_APPROVED", "REIMBURSED"],
        "requiredFields": ["workerName", "invoiceUpload", "invoiceDetails", "expenseType"],
        "prompts": {
          "he": ["חשבונית", "החזר", "קבלה", "הוצאה", "החזר כספי"],
          "en": ["invoice", "receipt", "refund", "expense", "reimbursement", "bill"]
        }
      },
      "formSchema": {
        "fields": [
          {
            "name": "workerName",
            "label": "Worker Name",
            "labelHe": "שם העובד",
            "type": "text",
            "required": true,
            "placeholder": "Enter worker name",
            "source": "user_input"
          },
          {
            "name": "invoiceUpload",
            "label": "Invoice Upload (OCR)",
            "labelHe": "העלאת חשבונית",
            "type": "file",
            "required": false,
            "accept": "image/*,application/pdf",
            "placeholder": "Upload invoice image or PDF",
            "source": "ocr"
          },
          {
            "name": "invoiceDetails",
            "label": "Invoice Details",
            "labelHe": "פרטי החשבונית",
            "type": "textarea",
            "required": true,
            "placeholder": "Enter invoice details manually if not uploading",
            "source": "user_input"
          },
          {
            "name": "expenseType",
            "label": "Expense Type",
            "labelHe": "סוג ההוצאה",
            "type": "select",
            "required": true,
            "options": [
              { "value": "parking", "label": "Parking", "labelHe": "חניה" },
              { "value": "food", "label": "Food", "labelHe": "אוכל" },
              { "value": "hotel", "label": "Hotel", "labelHe": "מלון" },
              { "value": "flight", "label": "Flight", "labelHe": "טיסה" },
              { "value": "conference", "label": "Conference", "labelHe": "כנס" },
              { "value": "other", "label": "Other", "labelHe": "אחר" }
            ],
            "placeholder": "Select expense type",
            "source": "user_input"
          }
        ]
      }
    },
    {
      "id": "travel",
      "name": "Travel Booking",
      "description": "Book business travel (flights, hotels, etc.)",
      "mode": "mock",
      "baseUrl": "https://api.company.com/travel",
      "mockBaseUrl": "/mock/travel",
      "auth": {
        "type": "none"
      },
      "operations": [
        {
          "id": "book",
          "method": "POST",
          "path": "/book",
          "inputSchema": "travel-book.request.json",
          "outputSchema": "travel-book.response.json",
          "description": "Create a travel booking"
        }
      ],
      "workflow": {
        "steps": ["DRAFT", "SUBMITTED", "APPROVED", "BOOKED"],
        "requiredFields": ["workerName", "travelersNames", "departureCity", "destinationCity", "passport", "departureFlightNumber", "returnFlightNumber", "hotelDetails"],
        "prompts": {
          "he": ["טיסה", "טיול פרטי", "נסיעת עבודה", "חופשה", "נסיעה", "טיול"],
          "en": ["flight", "trip", "travel", "vacation", "business trip", "journey"]
        }
      },
      "formSchema": {
        "fields": [
          {
            "name": "workerName",
            "label": "Worker Name",
            "labelHe": "שם העובד",
            "type": "text",
            "required": true,
            "placeholder": "Enter worker name",
            "source": "user_input"
          },
          {
            "name": "travelersNames",
            "label": "Travelers Names (Co-workers)",
            "labelHe": "שמות הנוסעים (עמיתים)",
            "type": "textarea",
            "required": false,
            "placeholder": "Enter names of co-workers traveling with you (one per line)",
            "source": "user_input",
            "multiple": true
          },
          {
            "name": "departureCity",
            "label": "Departure City",
            "labelHe": "עיר המוצא",
            "type": "text",
            "required": true,
            "placeholder": "Enter departure city",
            "source": "user_input"
          },
          {
            "name": "destinationCity",
            "label": "Destination City",
            "labelHe": "עיר היעד",
            "type": "text",
            "required": true,
            "placeholder": "Enter destination city",
            "source": "user_input"
          },
          {
            "name": "passport",
            "label": "Passport Number",
            "labelHe": "מספר דרכון",
            "type": "text",
            "required": true,
            "placeholder": "Passport number (auto-filled from internal API)",
            "source": "internal_api"
          },
          {
            "name": "departureFlightNumber",
            "label": "Departure Flight Number",
            "labelHe": "מספר טיסת יציאה",
            "type": "text",
            "required": true,
            "placeholder": "e.g., LY556",
            "source": "user_input"
          },
          {
            "name": "returnFlightNumber",
            "label": "Return Flight Number",
            "labelHe": "מספר טיסת חזרה",
            "type": "text",
            "required": true,
            "placeholder": "e.g., LY557",
            "source": "user_input"
          },
          {
            "name": "hotelDetails",
            "label": "Hotel Name and Address",
            "labelHe": "שם וכתובת המלון",
            "type": "textarea",
            "required": false,
            "placeholder": "Enter hotel name and address (or auto-filled from internal API)",
            "source": "internal_api_or_manual"
          }
        ]
      }
    }
  ]
}
